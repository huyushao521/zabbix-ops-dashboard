# 复制为 .env 后按实际情况修改（.env 已被 .gitignore 忽略）

# Zabbix 站点根地址，不要带 /zabbix 之类的子路径
ZABBIX_URL=http://192.168.1.10

# Zabbix 7 的 API Token：Web 界面 → Users → API tokens → Create API token
ZABBIX_TOKEN=replace-with-your-api-token

# 可选：Grafana 地址，默认 http://127.0.0.1:3000
# GRAFANA_URL=http://127.0.0.1:3000

# 可选：Web 服务监听地址，默认 127.0.0.1
# DASH_HOST=127.0.0.1
